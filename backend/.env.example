# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/ictg-events
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ictg-events
MONGO_URI=mongodb://127.0.0.1:27017/ictg-events

# Port the API server listens on
PORT=5000

# Comma-separated list of origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development

# Admin login (used by the frontend admin page)
# Set these to secure values in production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
JWT_SECRET=replace_me_with_a_strong_secret
